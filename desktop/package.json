{
  "name": "@shale/desktop",
  "version": "0.1.99",
  "private": true,
  "description": "Shale native desktop application",
  "author": "xnohat <xnohat@gmail.com>",
  "homepage": "https://github.com/AlexbeatsZ/Shale",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:bundle": "node scripts/check-server-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "start": "electron dist/main.js",
    "dev": "node scripts/build.mjs && electron dist/main.js",
    "clean:release": "node scripts/clean-release.mjs",
    "predist": "npm run clean:release",
    "dist": "node scripts/build.mjs && electron-builder",
    "predist:dir": "npm run clean:release",
    "dist:dir": "node scripts/build.mjs && electron-builder --dir",
    "predist:publish": "npm run clean:release",
    "dist:publish": "node scripts/build.mjs && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "io.github.alexbeatsz.shale",
    "productName": "Shale",
    "copyright": "Copyright © 2026 xnohat",
    "electronVersion": "33.4.11",
    "beforePack": "scripts/before-pack.cjs",
    "directories": {
      "output": "release/${version}",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": ".gen/server",
        "to": "server"
      },
      {
        "from": ".gen/tunnel/${arch}",
        "to": "mcp-tunnel"
      },
      {
        "from": ".gen/input-method/${arch}",
        "to": "input-method",
        "filter": [
          "im-select*",
          "LICENSE*",
          "migrate-keychain"
        ]
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "sign": "scripts/sign-mac.cjs",
      "icon": "buildResources/icon-macos.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "buildResources/icon-windows.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "include": "buildResources/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "guid": "2704e2ab-b45b-53dd-a908-5cf90746ea66"
    },
    "linux": {
      "icon": "buildResources/icon.png",
      "category": "Utility",
      "maintainer": "xnohat <xnohat@gmail.com>",
      "synopsis": "Personal Markdown notes app",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AlexbeatsZ",
        "repo": "Shale"
      }
    ]
  }
}
